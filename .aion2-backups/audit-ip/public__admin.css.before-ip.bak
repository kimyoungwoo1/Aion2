:root{color-scheme:dark;--bg:#0b101c;--panel:#182238;--line:#2d3b53;--text:#f5f5f6;--muted:#a4b2c8;--gold:#e9be78}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at top right,#233552 0%,var(--bg) 55%);color:var(--text);font:14px/1.6 system-ui,-apple-system,'Malgun Gothic',sans-serif}
.topbar{border-bottom:1px solid var(--line);background:#101827dd}.topbar-inner{max-width:1230px;margin:auto;padding:17px 20px;display:flex;justify-content:space-between;gap:12px;align-items:center}.brand{font-size:20px;font-weight:800;color:var(--gold);text-decoration:none}.top-actions{display:flex;align-items:center;gap:13px}.admin-label{font-size:13px;color:#ced7e7}
main{max-width:1230px;margin:auto;padding:27px 20px 70px}.heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:21px}.heading h1{font-size:26px;margin:0 0 4px}.heading p{color:var(--muted);margin:0}
.card{padding:22px;border:1px solid var(--line);border-radius:13px;background:var(--panel);box-shadow:0 8px 24px #0002}.unlock{max-width:440px;margin:30px auto}.unlock h2{font-size:20px;margin:0 0 8px}.unlock p{color:var(--muted)}.unlock form{display:grid;gap:12px}.unlock label,.filters label{font-weight:650;font-size:13px}input,select{width:100%;border:1px solid #42536e;background:#101a2c;color:var(--text);border-radius:8px;padding:10px 12px;font:inherit}input:focus,select:focus{outline:2px solid #b18a53;outline-offset:1px}
.button{border-radius:8px;padding:9px 13px;font:700 13px system-ui,sans-serif;cursor:pointer;text-decoration:none;white-space:nowrap;border:1px solid #45546d;color:var(--text)}.button:disabled{opacity:.5;cursor:wait}.primary{background:var(--gold);color:#211a13;border-color:var(--gold)}.muted-btn{background:#293850}.filters{display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin-bottom:13px}.filters label{display:grid;gap:5px;min-width:190px}.filters button{margin-bottom:0}.filters select{min-width:190px}.message{min-height:19px;color:#ffcbad;margin:10px 0}.tablewrap{width:100%;overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:850px}th{font-size:12px;text-align:left;color:var(--gold);background:#111b2d}th,td{padding:11px 9px;border-bottom:1px solid #2d3b53;vertical-align:top}td{font-size:13px}td:nth-child(1){white-space:nowrap}td:nth-child(4){min-width:170px}.category{display:inline-block;border:1px solid #496078;border-radius:8px;background:#1c2c43;color:#d3e5fb;padding:2px 7px;font-size:11px}.details{max-width:540px}.details summary{cursor:pointer;color:var(--gold);user-select:none}.details-grid{display:grid;gap:8px;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:8px}.details-grid div{min-width:0}.details-grid b{color:#b6cde9;font-size:11px}.details-grid pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;max-height:250px;overflow-y:auto;margin:5px 0 0;border:1px solid #34455f;border-radius:7px;padding:9px;background:#101a2c;font-size:11px}.pager{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:15px}.hint,.footer-note{font-size:12px;color:var(--muted)}.footer-note{line-height:1.8;margin-top:20px}
[hidden]{display:none!important}@media(max-width:680px){main{padding:20px 12px}.topbar-inner{padding:14px 12px}.admin-label{display:none}.card{padding:14px}.heading h1{font-size:22px}.filters{display:grid;grid-template-columns:1fr 1fr}.filters label{min-width:0}.filters select{min-width:0}.details-grid{grid-template-columns:1fr}}
